{
  "name": "bujoflow",
  "version": "1.0.0",
  "description": "BujoFlow - Cross-Device Digital Bullet Journal",
  "main": "index.html",
  "scripts": {
    "start": "npx serve . -l 3000",
    "android:init": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0"
  }
}
